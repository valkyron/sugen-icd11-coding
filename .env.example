# Sugen ICD-11 Coding Engine - Environment Configuration Example
# Copy to .env or pass directly via environment variables.
# Note: Do not commit actual secrets to Git.

# Model API Credentials (optional - system automatically falls back to offline engine if unset)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Model Selection (defaults to gpt-4o-mini / claude-3-5-haiku-latest)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional: Custom Gateway Base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# Network Proxy (honored automatically by OpenAI and Anthropic SDKs at runtime)
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
